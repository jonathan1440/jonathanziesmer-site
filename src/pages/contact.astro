---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const notices = {
  sent: 'Message sent. I will reply by email.',
  invalid: 'Check the name, email, and message, then try again.',
  unconfigured: 'The form is not connected to email yet. Use the address below.',
  failed: 'The message did not send. Use the address below.',
} as const;

type NoticeStatus = keyof typeof notices;

const status = Astro.url.searchParams.get('status');
const notice = status && status in notices ? notices[status as NoticeStatus] : null;

const description = 'Open to interesting engineering roles and freelance projects.';
---

<BaseLayout title="Contact" description={description}>
  <h1 class="text-4xl text-ink">Contact</h1>
  <p class="mt-6 max-w-[65ch]">Open to interesting engineering roles and freelance projects.</p>

  {
    notice && (
      <p class="mt-8 border border-line bg-surface px-4 py-3 text-sm text-ink" role="status">
        {notice}
      </p>
    )
  }

  <form class="relative mt-10 max-w-xl space-y-5" method="post" action="/api/contact">
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for="website">Website</label>
      <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div>
      <label for="name" class="block text-sm text-ink">Name</label>
      <input
        id="name"
        name="name"
        type="text"
        required
        maxlength="100"
        autocomplete="name"
        class="mt-2 w-full rounded-[2px] border border-line bg-background px-3 py-2 text-base text-ink"
      />
    </div>

    <div>
      <label for="email" class="block text-sm text-ink">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        maxlength="254"
        autocomplete="email"
        class="mt-2 w-full rounded-[2px] border border-line bg-background px-3 py-2 text-base text-ink"
      />
    </div>

    <div>
      <label for="subject" class="block text-sm text-ink">Subject <span class="text-muted">(optional)</span></label>
      <input
        id="subject"
        name="subject"
        type="text"
        maxlength="150"
        class="mt-2 w-full rounded-[2px] border border-line bg-background px-3 py-2 text-base text-ink"
      />
    </div>

    <div>
      <label for="message" class="block text-sm text-ink">Message</label>
      <textarea
        id="message"
        name="message"
        required
        maxlength="5000"
        rows="7"
        class="mt-2 w-full rounded-[2px] border border-line bg-background px-3 py-2 text-base text-ink"
      ></textarea>
    </div>

    <button
      type="submit"
      class="rounded-[2px] bg-accent px-4 py-2 text-sm text-white hover:bg-accent-dark"
    >
      Send
    </button>
  </form>

  <p class="mt-12 border-t border-line pt-8 text-base">
    Or email
    <a class="text-accent underline-offset-4 hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
  </p>
  <p class="mt-3">
    <a
      href={site.linkedin}
      class="text-sm text-ink underline-offset-4 hover:text-accent hover:underline"
    >
      LinkedIn
    </a>
  </p>
</BaseLayout>
